# Copy this file to .env and fill in real values. Never commit .env.

# Local Postgres from docker-compose.yml (run: docker compose up -d)
DATABASE_URL="postgresql://snipsh:snipsh@localhost:5432/snipsh"
DIRECT_URL="postgresql://snipsh:snipsh@localhost:5432/snipsh"

# Neon (cloud): DATABASE_URL is the pooled connection, DIRECT_URL is for Prisma migrations
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Secret that signs login tokens: at least 32 random characters (run: openssl rand -base64 48)
JWT_SECRET="why-did-the-chicken-cross-the-road-to-get-to-the-other-side"

# Port the API listens on (optional, defaults to 3000)
PORT=3000

# UI origins allowed to call the API from a browser, comma-separated (optional)
# CORS_ORIGIN="http://localhost:5173,https://snipsh.com"
